{
  "name": "@local/dsh-decision",
  "version": "0.1.0",
  "private": true,
  "description": "Decision 3.0 多模态决策模型接入：概率决策、图像定位与配额管理",
  "license": "MIT",
  "homepage": "https://github.com/xia-sc/dsh-decision#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xia-sc/dsh-decision.git"
  },
  "bugs": {
    "url": "https://github.com/xia-sc/dsh-decision/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "decision-model",
    "vllm-sr"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
