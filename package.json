{
  "name": "@xia-sc/dsh-decision",
  "version": "0.1.1",
  "description": "Decision 3.0 multimodal decision models for DeepSeek Harness: calibrated-probability tools, a Settings page and a probability-bar card",
  "license": "MIT",
  "homepage": "https://github.com/xia-sc/dsh-decision#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xia-sc/dsh-decision.git"
  },
  "bugs": {
    "url": "https://github.com/xia-sc/dsh-decision/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "decision-model",
    "vllm-sr",
    "multimodal"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "node scripts/preflight.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
